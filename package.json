{
  "name": "mdawiki-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typegen": "wrangler types",
    "check": "npm run typegen && tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "node tests/crud.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.1-beta",
    "esbuild": "0.28.2"
  },
  "dependencies": {
    "hono": "^4.10.0"
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  }
}
