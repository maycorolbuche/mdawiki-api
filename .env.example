# Use local to accept localhost and private IPv4 browser origins for development.
APP_ENV=production
APP_TIMEZONE=America/Sao_Paulo
# Temporarily enable to include original error messages and article filter diagnostics.
APP_DEBUG=false
ALLOWED_ORIGINS=https://mda.wiki.br,https://site.mda.wiki.br
FRONTEND_URL=https://mda.wiki.br
MEDIA_PUBLIC_URL=https://api.mda.wiki.br/media
# Generate once: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Keep this key stable and include it in backups. Never commit its real value.
APP_KEY=
SESSION_SECURE=true
# Optional absolute directories outside public/ (defaults: var and var/media).
# STORAGE_DIR=/home/account/mdawiki-api/var
# MEDIA_ROOT=/home/account/mdawiki-api/var/media
# Destination for new uploads: local or r2.
MEDIA_STORAGE_DRIVER=local
# Keep R2 credentials configured to read existing objects after switching back to local.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
MAIL_USER_COPY_TO=
MAIL_ADMIN_TO=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mdawiki
DB_USERNAME=mdawiki
DB_PASSWORD=
# Preserve the current schema. Validate actual stored bytes before changing this.
DB_CHARSET=latin1
PUBLIC_MAX_LEVEL=1
