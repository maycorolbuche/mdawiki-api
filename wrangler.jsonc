{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mdawiki-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "routes": [
    {
      "pattern": "api.mda.wiki.br",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mdawiki",
      // Substituir pelo UUID retornado por: npx wrangler d1 create mdawiki
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
