{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mdawiki-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "routes": [
    {
      "pattern": "api.mda.wiki.br",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mdawiki",
      "database_id": "6ccfe558-4387-43ad-a705-904981bba6ab",
      "migrations_dir": "migrations"
    }
  ]
}