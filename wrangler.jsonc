{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mdawiki-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "triggers": {
    "crons": [
      "13 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mdawiki",
      "database_id": "6ccfe558-4387-43ad-a705-904981bba6ab",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "mdawiki"
    }
  ],
  "vars": {
    "FRONTEND_URL": "https://mda.wiki.br",
    "ALLOWED_ORIGINS": "http://localhost:5006",
    "SMTP_HOST": "smtp-relay.brevo.com",
    "SMTP_PORT": "587",
    "SMTP_SECURE": "tls",
    "SMTP_FROM": "noreply@mda.wiki.br",
    "MAIL_USER_COPY_TO": "wiki@mda.wiki.br",
    "MAIL_ADMIN_TO": "wiki@mda.wiki.br"
  }
}
